+/* Lifetime follows the scheduler finished fence, not the entity or HW callback.
+ * Reset stop/start may detach HW callbacks without finishing a job. They must
+ * not drop/reacquire this reservation. Direct error signaling releases it too.
+ */
+static void drm_sched_admission_release(struct drm_sched_fence *f, int action)
+{
+	struct drm_gpu_scheduler *sched = f->sched;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sched->admission_lock, flags);
+	if (!WARN_ON_ONCE(!sched->bg_inflight))
+		WRITE_ONCE(sched->bg_inflight, sched->bg_inflight - 1);
+	trace_drm_sched_admission(f, action, ++sched->admission_serial,
+				sched->bg_inflight);
+	spin_unlock_irqrestore(&sched->admission_lock, flags);
+	drm_sched_run_job_queue(sched);
+	dma_fence_put(&f->finished); /* dispatch callback reference */
+}
+
+static void drm_sched_admission_done(struct dma_fence *f,
+				     struct dma_fence_cb *cb)
+{
+	struct drm_sched_fence *s_fence =
+		container_of(cb, struct drm_sched_fence, admission_cb);
+
+	drm_sched_admission_release(s_fence, 1);
+}
+
+static void drm_sched_admission_acquire(struct drm_sched_job *job)
+{
+	struct drm_gpu_scheduler *sched = job->sched;
+	struct drm_sched_fence *f = job->s_fence;
+	unsigned long flags;
+
+	if (!sched->bg_job_limit || job->s_priority < DRM_SCHED_PRIORITY_NORMAL)
+		return;
+
+	/* Only work_run_job acquires, and a work item never runs concurrently
+	 * with itself. Selection and dispatch use the same immutable job priority.
+	 */
+	f->admission_priority = job->s_priority;
+	f->admission_tracked = true;
+	dma_fence_get(&f->finished);
+	spin_lock_irqsave(&sched->admission_lock, flags);
+	WRITE_ONCE(sched->bg_inflight, sched->bg_inflight + 1);
+	WARN_ON_ONCE(sched->bg_inflight > sched->bg_job_limit);
+	f->admission_acquire = ++sched->admission_serial;
+	trace_drm_sched_admission(f, 0, f->admission_acquire,
+				sched->bg_inflight);
+	spin_unlock_irqrestore(&sched->admission_lock, flags);
+
+	/* Never take the finished-fence lock under admission_lock: completion
+	 * calls us with the fence lock held. -ENOENT means it already finished.
+	 */
+	if (dma_fence_add_callback(&f->finished, &f->admission_cb,
+				   drm_sched_admission_done))
+		drm_sched_admission_release(f, 1);
+}
+
+static void drm_sched_admission_cleanup(struct drm_sched_fence *f)
+{
+	/* remove_callback synchronizes with a running callback under fence->lock.
+	 * No job pointer is used by the callback; it owns a separate fence ref.
+	 * Cleanup is the fallback for a canceled job freed without signaling.
+	 */
+	if (f->admission_tracked &&
+	    dma_fence_remove_callback(&f->finished, &f->admission_cb))
+		drm_sched_admission_release(f, 2);
+}
