diff --git a/drivers/gpu/drm/scheduler/tests/tests_admission.c b/drivers/gpu/drm/scheduler/tests/tests_admission.c
new file mode 100644
index 0000000..3cafb71
--- /dev/null
+++ b/drivers/gpu/drm/scheduler/tests/tests_admission.c
@@ -0,0 +1,326 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Tests for the opt-in gfx admission experiment; no hardware required. */
+#include <linux/delay.h>
+#include "sched_tests.h"
+
+static int admission_init(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = drm_mock_sched_new(test, MAX_SCHEDULE_TIMEOUT);
+
+	s->base.credit_limit = 4;
+	s->base.bg_job_limit = 1;
+	test->priv = s;
+	return 0;
+}
+
+static void admission_exit(struct kunit *test)
+{
+	if (test->priv)
+		drm_mock_sched_fini(test->priv);
+}
+
+static struct drm_mock_sched_job *submit(struct kunit *test,
+					struct drm_mock_sched_entity *e)
+{
+	struct drm_mock_sched_job *j = drm_mock_sched_job_new(test, e);
+
+	drm_mock_sched_job_submit(j);
+	return j;
+}
+
+static void scheduled(struct kunit *test, struct drm_mock_sched_job *j)
+{
+	KUNIT_ASSERT_TRUE(test, drm_mock_sched_job_wait_scheduled(j, HZ));
+}
+
+static void admission_pipeline_off(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *e;
+	struct drm_mock_sched_job *a, *b;
+
+	s->base.bg_job_limit = 0;
+	s->base.skip_cap = true; /* With admission off, skipping has no effect. */
+	e = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	a = submit(test, e);
+	b = submit(test, e);
+	scheduled(test, a);
+	scheduled(test, b);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 2), 2);
+	drm_mock_sched_entity_free(e);
+}
+
+static void admission_combined_cap(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n, *l;
+	struct drm_mock_sched_job *a, *b;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	l = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_LOW, s);
+	a = submit(test, n);
+	scheduled(test, a);
+	b = submit(test, l);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_FALSE(test, dma_fence_is_signaled(&b->base.s_fence->scheduled));
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	scheduled(test, b); /* Completion must wake the blocked victim. */
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	drm_mock_sched_entity_free(n);
+	drm_mock_sched_entity_free(l);
+}
+
+static void admission_exempt(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n, *h, *k;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	h = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_HIGH, s);
+	k = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_KERNEL, s);
+	scheduled(test, submit(test, n));
+	scheduled(test, submit(test, h));
+	scheduled(test, submit(test, k));
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->base.credit_count), 3);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 3), 3);
+	drm_mock_sched_entity_free(n);
+	drm_mock_sched_entity_free(h);
+	drm_mock_sched_entity_free(k);
+}
+
+static void admission_all_blocked_skip(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+
+	s->base.skip_cap = true;
+	admission_combined_cap(test);
+}
+
+static void admission_priority_snapshot(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+	struct drm_mock_sched_job *a;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	a = submit(test, n);
+	scheduled(test, a);
+	drm_sched_entity_set_priority(&n->base, DRM_SCHED_PRIORITY_HIGH);
+	/* The dispatched job retains its original class even after entity teardown. */
+	drm_mock_sched_entity_free(n);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+}
+
+static void admission_stop_start(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	scheduled(test, submit(test, n));
+	drm_sched_stop(&s->base, NULL);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->base.credit_count), 0);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	/* No parent after stop: start cancels and finishes the pending job. */
+	drm_sched_start(&s->base, -ECANCELED);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->base.credit_count), 0);
+	drm_mock_sched_entity_free(n);
+}
+
+static void admission_direct_finish(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+	struct drm_mock_sched_job *a;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	a = submit(test, n);
+	scheduled(test, a);
+	drm_sched_wqueue_stop(&s->base);
+	dma_fence_set_error(&a->base.s_fence->finished, -EHWPOISON);
+	dma_fence_signal(&a->base.s_fence->finished);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	/* Hardware completion after exceptional finished signaling releases no
+	 * second reservation. Keep workers stopped until the HW callback ends.
+	 */
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	drm_sched_wqueue_start(&s->base);
+	flush_workqueue(s->base.submit_wq);
+	drm_mock_sched_entity_free(n);
+}
+
+static void admission_stop_start_rearm(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+	struct drm_mock_sched_job *j;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	j = submit(test, n);
+	scheduled(test, j);
+	drm_sched_stop(&s->base, NULL);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	/* Simulate recovery retaining a valid hardware fence, without the mock
+	 * backend's incompatible duplicate list insertion during resubmission.
+	 */
+	j->base.s_fence->parent = dma_fence_get(&j->hw_fence);
+	drm_sched_start(&s->base, 0);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	KUNIT_EXPECT_EQ(test, atomic_read(&s->base.credit_count), 1);
+	KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	drm_mock_sched_entity_free(n);
+}
+
+static void admission_cleanup_fallback(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	scheduled(test, submit(test, n));
+	drm_mock_sched_entity_free(n);
+	drm_sched_stop(&s->base, NULL); /* Detach HW callback without finishing. */
+	drm_mock_sched_fini(s); /* cancel/free must remove admission callback. */
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	test->priv = NULL;
+}
+
+static void admission_immediate(struct kunit *test)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *n;
+	const unsigned long cases[] = {
+		DRM_MOCK_SCHED_JOB_RUN_ERROR,
+		DRM_MOCK_SCHED_JOB_RUN_NULL,
+		DRM_MOCK_SCHED_JOB_RUN_SIGNALED,
+	};
+	int i;
+
+	n = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		struct drm_mock_sched_job *j = drm_mock_sched_job_new(test, n);
+		struct dma_fence *f;
+
+		j->flags |= cases[i];
+		drm_sched_job_arm(&j->base);
+		f = dma_fence_get(&j->base.s_fence->finished);
+		drm_sched_entity_push_job(&j->base);
+		KUNIT_EXPECT_GT(test, dma_fence_wait_timeout(f, false, HZ), 0);
+		flush_workqueue(s->base.submit_wq);
+		KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+		KUNIT_EXPECT_EQ(test, atomic_read(&s->base.credit_count), 0);
+		KUNIT_EXPECT_EQ(test, dma_fence_get_status(f), i ? 1 : -EIO);
+		dma_fence_put(f);
+	}
+	drm_mock_sched_entity_free(n);
+}
+
+/* Exercise a particular ready-tree shape, independent of fair's placement
+ * heuristic: a cap-blocked NORMAL head precedes a ready HIGH job. No worker
+ * may touch the tree during setup. Production selection still walks it.
+ */
+static void admission_head(struct kunit *test, bool skip, bool total_full)
+{
+	struct drm_mock_scheduler *s = test->priv;
+	struct drm_mock_sched_entity *a, *b, *h;
+	struct drm_mock_sched_job *bj, *hj;
+	struct drm_sched_rq *rq;
+	struct rb_node *root;
+	int i;
+
+	if (s->base.num_rqs != 1) {
+		kunit_skip(test, "Requires fair's single run queue; rerun with sched_policy=2");
+		return;
+	}
+	s->base.skip_cap = skip;
+	s->base.credit_limit = total_full ? 1 : 4;
+	a = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	b = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_NORMAL, s);
+	h = drm_mock_sched_entity_new(test, DRM_SCHED_PRIORITY_HIGH, s);
+	scheduled(test, submit(test, a));
+	drm_sched_wqueue_stop(&s->base);
+	bj = submit(test, b);
+	hj = submit(test, h);
+	rq = s->base.sched_rq[0];
+	spin_lock(&rq->lock);
+	rb_erase_cached(&b->base.rb_tree_node, &rq->rb_tree_root);
+	rb_erase_cached(&h->base.rb_tree_node, &rq->rb_tree_root);
+	b->base.oldest_job_waiting = 0;
+	h->base.oldest_job_waiting = 1;
+	rb_link_node(&b->base.rb_tree_node, NULL, &rq->rb_tree_root.rb_root.rb_node);
+	rb_insert_color_cached(&b->base.rb_tree_node, &rq->rb_tree_root, true);
+	root = &b->base.rb_tree_node;
+	rb_link_node(&h->base.rb_tree_node, root, &root->rb_right);
+	rb_insert_color_cached(&h->base.rb_tree_node, &rq->rb_tree_root, false);
+	spin_unlock(&rq->lock);
+	drm_sched_wqueue_start(&s->base);
+	flush_workqueue(s->base.submit_wq);
+	KUNIT_EXPECT_FALSE(test, dma_fence_is_signaled(&bj->base.s_fence->scheduled));
+	KUNIT_EXPECT_EQ(test, dma_fence_is_signaled(&hj->base.s_fence->scheduled),
+			 skip && !total_full);
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 1);
+	/* Drain each hardware job, allowing queued victims to dispatch in between. */
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_EQ(test, drm_mock_sched_advance(s, 1), 1);
+		flush_workqueue(s->base.submit_wq);
+	}
+	KUNIT_EXPECT_EQ(test, s->base.bg_inflight, 0);
+	drm_mock_sched_entity_free(a);
+	drm_mock_sched_entity_free(b);
+	drm_mock_sched_entity_free(h);
+}
+
+static void admission_head_stock(struct kunit *test)
+{
+	admission_head(test, false, false);
+}
+
+static void admission_head_skip(struct kunit *test)
+{
+	admission_head(test, true, false);
+}
+
+static void admission_total_not_skipped(struct kunit *test)
+{
+	admission_head(test, true, true);
+}
+
+static struct kunit_case admission_cases[] = {
+	KUNIT_CASE(admission_pipeline_off),
+	KUNIT_CASE(admission_combined_cap),
+	KUNIT_CASE(admission_all_blocked_skip),
+	KUNIT_CASE(admission_exempt),
+	KUNIT_CASE(admission_priority_snapshot),
+	KUNIT_CASE(admission_stop_start),
+	KUNIT_CASE(admission_stop_start_rearm),
+	KUNIT_CASE(admission_direct_finish),
+	KUNIT_CASE(admission_cleanup_fallback),
+	KUNIT_CASE(admission_immediate),
+	KUNIT_CASE(admission_head_stock),
+	KUNIT_CASE(admission_head_skip),
+	KUNIT_CASE(admission_total_not_skipped),
+	{}
+};
+
+static struct kunit_suite admission_suite = {
+	.name = "drm_sched_admission",
+	.init = admission_init,
+	.exit = admission_exit,
+	.test_cases = admission_cases,
+};
+kunit_test_suite(admission_suite);
